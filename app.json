{
  "expo": {
    "name": "Erëmīa",
    "slug": "eremia",
    "scheme": "eremia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17181E",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tsikyseiki.eremia"
    },
    "android": {
      "package": "com.tsikyseiki.eremia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17181E"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#17181E"
    }
  }
}